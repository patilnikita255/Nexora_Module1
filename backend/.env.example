# ============================================================================
# AI Video Surveillance - Backend Environment Template
# Copy this file to .env and update values as needed.
# ============================================================================

# ------------------------------ YOLO / Inference ------------------------------
# Model file path, relative to backend folder.
# Example: weights/yolov8n.pt, weights/yolov8m.pt
YOLO_MODEL=weights/yolov8m.pt

# Detection confidence threshold (0.0 to 1.0).
# Lower value = more detections (more false positives), higher = stricter.
YOLO_CONFIDENCE=0.5

# Inference device: auto | cuda | cpu | mps
# auto chooses the best available device.
DEVICE=auto


# ------------------------------- API Server -----------------------------------
# Host and port used by FastAPI/Uvicorn.
HOST=0.0.0.0
PORT=8000


# --------------------------- Behavior Thresholds -------------------------------
# Loitering alert threshold in seconds.
LOITERING_THRESHOLD_SECONDS=20

# Restricted zone as normalized rectangle: x1,y1,x2,y2 (range 0.0-1.0).
# Example below marks the right-side 40% of frame.
INTRUSION_ZONE=0.6,0.0,1.0,1.0

# Unattended object threshold in seconds.
UNATTENDED_OBJECT_SECONDS=15

# Cooldown time in seconds to suppress duplicate alerts for same object/type.
ALERT_COOLDOWN_SECONDS=20


# --------------------------- Frontend / CORS ----------------------------------
# Frontend URL allowed by backend CORS.
# Use your frontend dev server URL.
FRONTEND_URL=http://localhost:8080


# ----------------------------- Storage Paths ----------------------------------
# Folder to store captured alert snapshots.
SNAPSHOTS_DIR=snapshots

# Folder to store uploaded videos.
UPLOADS_DIR=uploads

# Folder where YOLO weights are stored.
WEIGHTS_DIR=weights


# ----------------------------- Notifications ----------------------------------
# Email (uses Python smtplib — no extra dependency)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=recipient1@example.com,recipient2@example.com

# SMS (uses Twilio — requires `twilio` in requirements.txt)
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_TO=+1987654321